{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "mcp": {
    "laravel-boost": {
      "type": "local",
      "enabled": true,
      "command": [
        "php",
        "artisan",
        "boost:mcp"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "ctx7sk-f0d942da-19f1-478e-aaf6-394c4028469c"
      },
      "enabled": true
    },
    "codebase-memory-mcp": {"command":["C:/Users/Admin/.local/bin/codebase-memory-mcp.exe"],"type":"local"},
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  }
}