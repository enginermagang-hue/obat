################################################################################
# Laravel / PHP
################################################################################

/vendor
/node_modules

# Environment
/.env
/.env.*
!.env.example

# Database
database/*.sqlite
database/*.sqlite-*
database/.gitignore
database/migrations/.gitignore

# Backups (runtime data, not source)
/backups
/backups/*
!/backups/.gitkeep

# Temp files (runtime data)
/tmp
/tmp/*
!/tmp/.gitkeep

# PHPUnit
.phpunit.result.cache
.phpunit/

# Pest
.pest

# Debug / runtime artifacts
Checksum
Latest
_debug_prefill.php

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.vs/
.vscode/

# Build artifacts
*.zip
*.tar.gz

# Logs
*.log
storage/logs/*.log

# Auth keys
AuthKeys.txt

# IDE helper
.idea/
.phpstorm.meta.php

################################################################################
# Laravel-specific (storage subdirectories have their own .gitignore)
################################################################################

# Compiled Blade views — generated, do not commit
/storage/framework/views/*

# Keep storage subdirectory .gitignore files in VCS
/storage/app/.gitignore
/storage/app/private/.gitignore
/storage/app/public/.gitignore
/storage/framework/.gitignore
/storage/framework/cache/.gitignore
/storage/framework/cache/data/.gitignore
/storage/framework/sessions/.gitignore
/storage/framework/testing/.gitignore
/storage/logs/.gitignore

# Vite build output — regenerated via `npm run build`
/public/build
/public/fonts-manifest.dev.json
